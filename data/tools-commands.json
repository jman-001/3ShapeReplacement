    {
      "id": "health-commands",
      "category": "commands",
      "title": "Windows Health Commands",
      "description": "Commands to analyze and restore possible corrupted files for windows",
      "platforms": ["Command Prompt"],
      "tags": [
        "Windows",
        "Corrupted Files"
      ],
      "content": {
        "type": "command",
        "value": "sfc /scannow \nDISM /Online /Cleanup-Image /RestoreHealth"
      },
      "actions": [
        {
          "type": "copy",
          "label": "Copy command"
        }
      ]
    },
    {
      "id": "show-ip-configuration",
      "category": "commands",
      "title": "Show IP Configuration",
      "description": "Displays the complete Windows network configuration.",
      "platforms": ["Command Prompt"],
      "tags": [
        "network",
        "diagnostics"
      ],
      "content": {
        "type": "command",
        "value": "ipconfig /all"
      },
      "actions": [
        {
          "type": "copy",
          "label": "Copy command"
        }
      ]
    },
    {
      "id": "autoconfig",
      "category": "commands",
      "title": "Autoconfiguration setup",
      "description": "Shows and configure the Autoconfig for disconnection cases. ",
      "platforms": ["Power Shell"],
      "tags": [
        "network",
        "disconnection"
      ],
      "content": {
        "type": "command",
        "value": "netsh wlan show interfaces \nnetsh wlan set autoconfig no \"Wi-Fi 3\"\nnetsh wlan show autoconfig"
      },
      "actions": [
        {
          "type": "copy",
          "label": "Copy command"
        }
      ]
    }

  ]
